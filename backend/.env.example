# --- Simulation mode: leave everything empty, system runs fully locally ---

# Azure OpenAI (enables real LLM generation instead of simulated answers)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Azure AI Search (enables live index retrieval instead of the simulation store)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=

# Embeddings (enables hybrid vector+keyword search)
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Governance
DSS_DEFAULT_QUOTA=5000
